# Copy to .dev.vars (git-ignored) for `wrangler dev --local`. LOCAL VALUES ONLY — never real secrets here.
# The Worker refuses to start serving if these mix environments (see src/core/envSchema.ts).
ENV_TAG=local
DATABASE_URL=postgres://app_api:app_api_local_only@127.0.0.1:54339/yoland_local
AUTH_DATABASE_URL=postgres://app_auth:app_auth_local_only@127.0.0.1:54339/yoland_local
ADMIN_DATABASE_URL=postgres://admin_ops:admin_ops_local_only@127.0.0.1:54339/yoland_local
BETTER_AUTH_SECRET=local-only-auth-secret-change-me-0000000000
TICKET_SECRET=local-only-ticket-secret-change-me-000000000
RESULT_SECRET=local-only-result-secret-change-me-000000000
BETTER_AUTH_URL=http://127.0.0.1:8787
APP_ORIGIN=http://127.0.0.1:5173
# Human check: off (default) | fake (local tests: token "local-fake-pass") | turnstile (uat/prod, real secret via wrangler secret)
TURNSTILE_MODE=off
# WebSocket lifetime cap in seconds (default 86400 = 24 h; local min 2, uat/prod min 3600)
# WS_MAX_LIFETIME_S=86400
