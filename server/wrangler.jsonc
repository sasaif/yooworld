// LOCAL DEVELOPMENT ONLY (Phase B). No account_id, no routes, no secrets in this file: `wrangler dev --local` only.
// env.uat / env.prod are DEFINED for review but have never been deployed; Phase C needs Alessandro's own
// Cloudflare account (account_id, Hyperdrive/Neon, secrets via `wrangler secret put`). Secrets: see .dev.vars.example.
{
  "name": "yoland-api-local",
  "main": "src/cf/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": { "ENV_TAG": "local" },
  "durable_objects": { "bindings": [
    { "name": "ROOM", "class_name": "RoomDO" },
    { "name": "DIRECTORY", "class_name": "DirectoryDO" },
    { "name": "TABLE", "class_name": "TableDO" },
    { "name": "TRADE", "class_name": "TradeDO" },
    { "name": "PRESENCE", "class_name": "PresenceDO" }, { "name": "OUTBOX", "class_name": "OutboxDO" }
  ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["RoomDO", "DirectoryDO", "TableDO"] }, { "tag": "v2", "new_sqlite_classes": ["TradeDO"] }, { "tag": "v3", "new_sqlite_classes": ["PresenceDO"] }, { "tag": "v4", "new_sqlite_classes": ["OutboxDO"] } ],
  "env": {
    "uat": {
      "name": "yoland-api-uat",
      "workers_dev": false,
      "vars": { "ENV_TAG": "uat" },
      "durable_objects": { "bindings": [
        { "name": "ROOM", "class_name": "RoomDO" }, { "name": "DIRECTORY", "class_name": "DirectoryDO" }, { "name": "TABLE", "class_name": "TableDO" }, { "name": "TRADE", "class_name": "TradeDO" }, { "name": "PRESENCE", "class_name": "PresenceDO" }, { "name": "OUTBOX", "class_name": "OutboxDO" }
      ] }
    },
    "prod": {
      "name": "yoland-api-prod",
      "workers_dev": false,
      "vars": { "ENV_TAG": "prod" },
      "durable_objects": { "bindings": [
        { "name": "ROOM", "class_name": "RoomDO" }, { "name": "DIRECTORY", "class_name": "DirectoryDO" }, { "name": "TABLE", "class_name": "TableDO" }, { "name": "TRADE", "class_name": "TradeDO" }, { "name": "PRESENCE", "class_name": "PresenceDO" }, { "name": "OUTBOX", "class_name": "OutboxDO" }
      ] }
    }
  }
}
